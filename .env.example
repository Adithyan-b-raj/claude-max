# OpusMax Proxy — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# Required
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ADMIN_SECRET=your-admin-secret-password-here

# Database
DATABASE_PATH=./data/opusmax.db

# Server
PORT=3000
NODE_ENV=production

# Optional — upstream override (default: https://api.anthropic.com/v1)
# ANTHROPIC_API_BASE=https://api.anthropic.com/v1
